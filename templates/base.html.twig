<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}System zgłaszania artykułów naukowych{% endblock %}</title>
    <style>
        :root { --brand: #1e3a8a; --bg: #f5f6fa; --border: #dfe3ea; }
        * { box-sizing: border-box; }
        body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; margin: 0; background: var(--bg); color: #1f2430; }
        header { background: var(--brand); color: #fff; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
        header a { color: #fff; text-decoration: none; }
        nav a { margin-right: 1rem; font-size: 0.9rem; }
        main { max-width: 1000px; margin: 2rem auto; padding: 0 1rem; }
        .card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 1rem; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--border); }
        .btn { display: inline-block; background: var(--brand); color: #fff; padding: 0.5rem 1rem; border: none; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 0.9rem; }
        .btn.secondary { background: #6b7280; }
        .btn.danger { background: #b91c1c; }
        .status { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 12px; font-size: 0.8rem; background: #e5e7eb; }
        .flash { padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
        .flash.success { background: #dcfce7; color: #166534; }
        .flash.error { background: #fee2e2; color: #991b1b; }
        label { display: block; margin: 0.75rem 0 0.25rem; font-weight: 600; font-size: 0.9rem; }
        input, textarea, select { width: 100%; padding: 0.5rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.95rem; }
        form { margin-top: 0.5rem; }
    </style>
</head>
<body>
<header>
    <a href="{{ path('app_dashboard') }}"><strong>System Zgłaszania Artykułów</strong></a>
    <nav>
        {% if app.user %}
            <a href="{{ path('app_article_index') }}">Moje zgłoszenia</a>
            <a href="{{ path('app_article_new') }}">Nowe zgłoszenie</a>
            <a href="{{ path('app_search') }}">Wyszukaj</a>
            <a href="{{ path('app_article_published') }}">Publikacje</a>
            {% if is_granted('ROLE_REVIEWER') %}<a href="{{ path('app_review_index') }}">Recenzje</a>{% endif %}
            {% if is_granted('ROLE_EDITOR') %}<a href="{{ path('app_publication_index') }}">Panel redakcji</a>{% endif %}
            {% if is_granted('ROLE_EDITOR') %}<a href="{{ path('app_stats') }}">Statystyki</a>{% endif %}
            <a href="{{ path('app_logout') }}">Wyloguj ({{ app.user.fullName }})</a>
        {% else %}
            <a href="{{ path('app_login') }}">Zaloguj</a>
            <a href="{{ path('app_register') }}">Zarejestruj</a>
        {% endif %}
    </nav>
</header>
<main>
    {% for type, messages in app.flashes(['success', 'error']) %}
        {% for message in messages %}
            <div class="flash {{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
