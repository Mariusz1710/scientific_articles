{% extends 'base.html.twig' %}
{% block title %}Moje zgłoszenia{% endblock %}
{% block body %}
    <div class="card">
        <h1>Moje zgłoszenia</h1>
        <p><a class="btn" href="{{ path('app_article_new') }}">+ Nowe zgłoszenie</a></p>

        {% if articles|length == 0 %}
            <p>Nie masz jeszcze żadnych zgłoszeń.</p>
        {% else %}
            <table>
                <thead><tr><th>Tytuł</th><th>Dział</th><th>Status</th><th>Aktualizacja</th></tr></thead>
                <tbody>
                {% for article in articles %}
                    <tr>
                        <td><a href="{{ path('app_article_show', {id: article.id}) }}">{{ article.title }}</a></td>
                        <td>{{ article.category.name }}</td>
                        <td><span class="status">{{ article.status.label }}</span></td>
                        <td>{{ article.updatedAt|date('Y-m-d H:i') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
